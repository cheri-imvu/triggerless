<Window x:Class="ExposeOutfitsApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expose Outfit" Height="800" Width="1200">

	<DockPanel>

		<!-- Input -->
		<StackPanel DockPanel.Dock="Top" Margin="10">

			<TextBlock FontSize="24"
               FontWeight="Bold"
               Text="Expose Outfit" />

			<TextBox Text="{Binding InputUrl}"
             AcceptsReturn="True"
             Height="100"
             TextWrapping="Wrap"
             x:Name="PasteUrlTextBox"/>

			<Button Content="Load"
            Click="Load_Click"
            Width="120"
            Margin="0,10,0,0"/>

			<ProgressBar Height="20"
                 Margin="0,10,0,0"
                 Minimum="0"
                 Maximum="{Binding State.ProgressMaximum}"
                 Value="{Binding State.ProgressValue}" />

		</StackPanel>

		<!-- Scrollable Content -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- Room -->
				<Expander Header="Room" IsExpanded="False">
					<ItemsControl ItemsSource="{Binding Room}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Margin="5" Padding="5" BorderBrush="Gray" BorderThickness="1">
									<StackPanel Width="120">
										<Image Source="{Binding ImageUrl}"
                                               Width="100" Height="80"/>
										<TextBlock Text="{Binding Name}"
                                                   TextDecorations="Underline"/>
										<TextBlock Text="{Binding CreatorName}"
                                                   FontSize="10"
                                                   TextDecorations="Underline"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Expander>

				<!-- Users -->
				<ItemsControl ItemsSource="{Binding Users}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Expander Header="{Binding Name}" IsExpanded="False">
								<StackPanel>
									<Image Source="{Binding ImageUrl}"
                                           Width="120" Height="120"
                                           Margin="5"/>
									<ItemsControl ItemsSource="{Binding Products}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Margin="5" Padding="5" BorderBrush="Gray" BorderThickness="1">
													<StackPanel Width="120">
														<Image Source="{Binding ImageUrl}"
                                                               Width="100" Height="80"/>
														<TextBlock Text="{Binding Name}"
                                                                   TextDecorations="Underline"/>
														<TextBlock Text="{Binding CreatorName}"
                                                                   FontSize="10"
                                                                   TextDecorations="Underline"/>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Expander>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>
		</ScrollViewer>

	</DockPanel>
</Window>
